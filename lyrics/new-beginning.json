    {
      "id": "outro",
      "type": "outro",
      "lines": [
        {
          "id": "outro-01",
          "text": "New dawn... new skin...",
          "start": null,
          "end": null
        },
        {
          "id": "outro-02",
          "text": "(Distant female harmonies drift further away.)",
          "start": null,
          "end": null
        },
        {
          "id": "outro-03",
          "text": "It's a beautiful start...",
          "start": null,
          "end": null
        },
        {
          "id": "outro-04",
          "text": "(A light switch click, or the soft sound of a car door closing, gently ends the song.)",
          "start": null,
          "end": null
        }
      ]
